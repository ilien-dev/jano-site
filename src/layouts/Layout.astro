---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  jsonLd?: object;
  // Set on the home page in each language; adds the hreflang links between them.
  lang?: 'en' | 'es';
  locale?: string;
  ogImageAlt?: string;
  // A page with no other-language twin (the 404s): no hreflang links, and kept out of search results.
  standalone?: boolean;
}

const {
  title,
  description,
  jsonLd,
  lang,
  locale = 'en_US',
  ogImageAlt = 'Jano: animated GitHub README banners for dark and light mode.',
  standalone = false,
} = Astro.props;
const twins = lang && !standalone;
const site = 'https://jano.ilien.dev';
const canonical = new URL(Astro.url.pathname, site).href;
---

<!doctype html>
<html lang={lang ?? 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      twins && (
        <>
          <link rel="alternate" hreflang="en" href={`${site}/`} />
          <link rel="alternate" hreflang="es" href={`${site}/es/`} />
          <link rel="alternate" hreflang="x-default" href={`${site}/`} />
        </>
      )
    }
    <link rel="preload" href="/fonts/space-grotesk.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0A1020" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#F4F6FA" media="(prefers-color-scheme: light)" />
    <script is:inline>
      // Before the first paint: apply a saved light or dark choice. No choice follows the system.
      (() => {
        let t = null;
        try { t = localStorage.getItem('theme'); } catch {}
        if (t !== 'light' && t !== 'dark') return;
        document.documentElement.dataset.theme = t;
        for (const m of document.querySelectorAll('meta[name="theme-color"]')) m.content = t === 'light' ? '#F4F6FA' : '#0A1020';
      })();
    </script>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Jano" />
    <meta property="og:locale" content={locale} />
    {standalone && <meta name="robots" content="noindex" />}
    {twins && <meta property="og:locale:alternate" content={locale === 'es_ES' ? 'en_US' : 'es_ES'} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${site}/brand/og.png`} />
    <meta property="og:image:width" content="1600" />
    <meta property="og:image:height" content="473" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <slot />
  </body>
</html>
