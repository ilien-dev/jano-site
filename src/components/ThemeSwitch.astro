---
import Icon from './Icon.astro';

interface Props {
  t?: { label: string; light: string; dark: string; system: string };
}
const { t = { label: 'Theme', light: 'Light', dark: 'Dark', system: 'System' } } = Astro.props;
const options = [
  { value: 'light', icon: 'Sun', label: t.light },
  { value: 'dark', icon: 'Moon', label: t.dark },
  { value: 'system', icon: 'Monitor', label: t.system },
];
---

<div class="tmenu" id="tsw" data-choice="system" data-menu="closed">
  <button type="button" class="btn btn-sm tm-btn" id="tm-btn" aria-haspopup="menu" aria-expanded="false" aria-controls="tm-list" aria-label={`${t.label}: ${t.system}`} data-label={t.label}>
    {options.map((o) => <Icon name={o.icon} size={18} class={`i-${o.value}`} />)}
  </button>
  <div class="tm-list" id="tm-list" role="menu" aria-labelledby="tm-btn">
    {
      options.map((o) => (
        <button type="button" role="menuitemradio" data-theme-choice={o.value} aria-checked={o.value === 'system' ? 'true' : 'false'} tabindex="-1">
          <Icon name={o.icon} size={17} />
          <span>{o.label}</span>
          <Icon name="Check" size={16} class="tm-check" />
        </button>
      ))
    }
  </div>
</div>
