---
// The home page, in the language the route passes. Every string lives in src/i18n.ts.
import Layout from '../layouts/Layout.astro';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import Cmd from './Cmd.astro';
import ThemeSwitch from './ThemeSwitch.astro';
import { agents } from '../data/projects';
import { strings, projectsFor, fill, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = strings[lang];
const projects = projectsFor(lang);
const site = 'https://jano.ilien.dev';

// Each half of a column must be taller than the column (1500px, ~202px per tile),
// or the loop shows a gap that fills in all at once when the animation restarts.
const PER_HALF = 8;
const cols = [0, 1, 2, 3, 4].map((ci) => {
  const one = Array.from({ length: PER_HALF }, (_, k) => {
    const p = projects[(ci * 3 + k) % projects.length];
    return { slug: p.slug, mode: (ci + k) % 2 === 1 ? 'light' : 'dark' };
  });
  return one.concat(one);
});
// The version shown under the hero buttons, read from the skill's plugin manifest at build time.
// If GitHub cannot be reached, the line is left out instead of showing a stale number.
let version: string | null = null;
try {
  const res = await fetch('https://raw.githubusercontent.com/ilien-dev/jano/main/.claude-plugin/plugin.json');
  if (res.ok) version = (await res.json()).version ?? null;
} catch {}
const localAgents = agents.map((g) => (g.name === 'More agents' ? { ...g, name: s.moreAgents } : g));
const agentLoop = [...localAgents, ...localAgents, ...localAgents, ...localAgents];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: 'Jano',
      url: `${site}${s.path}`,
      inLanguage: lang,
      description: s.description,
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Windows, macOS, Linux',
      license: 'https://opensource.org/licenses/MIT',
      sameAs: 'https://github.com/ilien-dev/jano',
      keywords: s.keywords,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    },
    {
      '@type': 'FAQPage',
      inLanguage: lang,
      mainEntity: s.faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<Layout lang={lang} title={s.title} description={s.description} jsonLd={jsonLd} ogImageAlt={s.ogImageAlt} locale={s.locale}>
  <div class="relative overflow-hidden">
    <header class="absolute inset-x-0 top-0 z-10">
      <nav aria-label={s.navMain} class="mx-auto flex max-w-[1240px] flex-wrap items-center justify-between gap-4 px-6 py-5">
        <a href="#top" aria-label={s.navHome} class="flex items-center gap-3 text-ink no-underline hover:text-ink">
          <Logo />
          <span class="text-[22px] font-semibold">Jano</span>
        </a>
        <div class="flex items-center gap-3">
          <a class="btn btn-sm btn-show" href="#gallery"><Icon name="LayoutGrid" />{s.showroom}</a>
          <a class="btn btn-sm btn-gh" href="https://github.com/ilien-dev/jano" aria-label="GitHub"><Icon name="github" /><span class="gh-t">GitHub</span> <Icon name="ArrowUpRight" size={16} class="arr" /></a>
          <a class="btn btn-sm" href={s.altHref} hreflang={s.altLang} lang={s.altLang} aria-label={s.altLabel}>{s.altShort}</a>
          <ThemeSwitch t={s.theme} />
        </div>
      </nav>
    </header>

    <!-- Hero: wall of real banners -->
    <section id="top" class="stage relative h-[680px] overflow-hidden sm:h-[820px]">
      <div class="wall" aria-hidden="true" inert>
        {
          cols.map((col) => (
            <div class="col">
              <div class="colin">
                {col.map((t) => (
                  <div class="tile">
                    <img data-src={`/banners/${t.slug}/hero-${t.mode}.svg`} alt="" width="1280" height="640" decoding="async" fetchpriority="low" />
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </div>
      <div class="pointer-events-none absolute inset-0 bg-night/70"></div>
      <div class="veil-b"></div>
      <div class="absolute inset-0 flex items-center justify-center px-6 pt-24 pb-10">
        <div class="flex max-w-[900px] flex-col items-center gap-6 text-center">
          <span class="rise inline-flex items-center gap-2 rounded-full border-[1.5px] border-line bg-deep px-4 py-2 font-mono text-sm text-body"><Icon name="Sparkles" size={16} class="text-hot" />{s.pill}</span>
          <h1 class="m-0 text-[clamp(46px,7vw,100px)] leading-[0.96] font-semibold tracking-[-0.03em]">
            {s.h1a} <span class="text-hot">{s.h1b}</span>
          </h1>
          <p class="rise m-0 max-w-[46ch] text-[clamp(18px,2vw,21px)] leading-normal text-body">
            {s.lead}
          </p>
          <div class="rise flex flex-wrap justify-center gap-3" style="animation-delay:.12s">
            <a class="btn btn-pri" href="#install"><Icon name="Download" />{s.ctaInstall} <Icon name="ArrowRight" size={16} class="arr" /></a>
            <a class="btn" href="#gallery"><Icon name="Images" />{s.ctaBrowse}</a>
          </div>
          {version && (
            <a class="rise font-mono text-sm text-body no-underline hover:text-ink" style="animation-delay:.18s" href={`https://github.com/ilien-dev/jano/releases/tag/v${version}`}>
              {s.version} v{version}
            </a>
          )}
        </div>
      </div>
    </section>

    <main class="relative">
      <div class="dots" aria-hidden="true"></div>

      <!-- Install -->
      <div class="relative mx-auto max-w-[1240px] px-6">
        <section id="install" class="reveal flex flex-wrap items-start gap-10 pt-10 pb-24">
          <div class="min-w-0 flex-[1_1_360px] lg:pt-8">
            <p class="eyebrow"><Icon name="Download" size={16} />{s.install}</p>
            <h2 class="m-0 mb-4 text-[clamp(34px,4.4vw,56px)] leading-[1.04] font-semibold">{s.installH}</h2>
            <p class="m-0 text-lg leading-relaxed text-body">
              {s.installP1} <a href="https://docs.astral.sh/uv/">uv</a>{s.installP2} <code class="font-mono text-[0.9em] text-ink">pip install fonttools brotli</code>{s.installP3}
            </p>
          </div>
          <div class="relative flex min-w-0 flex-[1.3_1_520px] flex-col gap-[18px] rounded-[22px] border-[1.5px] border-line bg-deep p-[clamp(22px,3vw,40px)]">
            <div class="seg" role="tablist" aria-label={s.installMethod} data-tab="plugin" id="seg">
              <span class="knob" aria-hidden="true"></span>
              <button type="button" role="tab" id="tab-plugin" aria-selected="true" aria-controls="panel-plugin" data-tab-btn="plugin">
                <img src="/logos/claude.svg" alt="" width="18" height="18" class="tab-logo" />{s.tabPlugin}
              </button>
              <button type="button" role="tab" id="tab-npx" aria-selected="false" aria-controls="panel-npx" data-tab-btn="npx" tabindex="-1">
                <Icon name="npm" size={18} class="tab-npm" />{s.tabNpx}
              </button>
            </div>
            <div class="panels">
              <div class="panel" role="tabpanel" id="panel-plugin" aria-labelledby="tab-plugin" data-active="true">
                <Cmd text="/plugin marketplace add ilien-dev/jano" label={s.copyMarket} copy={s.copy} prefix="1" />
                <Cmd text="/plugin install jano@jano" label={s.copyPlugin} copy={s.copy} prefix="2" />
                <p class="hint"><Icon name="CornerDownRight" size={16} />{s.then} <span class="sk">/jano:jano</span> {s.inProject}</p>
              </div>
              <div class="panel" role="tabpanel" id="panel-npx" aria-labelledby="tab-npx" data-active="false" inert>
                <Cmd text="npx skills add ilien-dev/jano" label={s.copyNpx} copy={s.copy} prefix="$" />
                <p class="hint"><Icon name="CornerDownRight" size={16} />{s.then} <span class="sk">/jano</span> · <span class="sk">$jano</span> · {s.useSkill}</p>
                <p class="hint"><Icon name="Puzzle" size={16} />{s.agentsHint}</p>
              </div>
            </div>
          </div>
        </section>
      </div>

      <!-- How to use -->
      <div class="relative mx-auto max-w-[1240px] px-6">
        <section id="use" aria-labelledby="use-h" class="reveal pb-20">
          <div class="mb-8 flex flex-wrap items-end justify-between gap-6">
            <div class="max-w-[640px]">
              <p class="eyebrow"><Icon name="BookOpen" size={16} />{s.useEyebrow}</p>
              <h2 id="use-h" class="m-0 text-[clamp(32px,4vw,52px)] leading-[1.05] font-semibold">{s.useH}</h2>
            </div>
            <p class="m-0 max-w-[44ch] text-lg leading-relaxed text-body">
              {s.useP1} <code class="sk font-mono text-[0.9em]">/jano</code> {s.useP2} (<code class="sk font-mono text-[0.9em]">/jano:jano</code> {s.useP3}), <code class="sk font-mono text-[0.9em]">$jano</code> {s.useP4}.
            </p>
          </div>
          <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,480px),1fr))] gap-5">
            <article class="win flex flex-col">
              <div class="winbar"><Icon name="Image" size={16} class="text-hot" /><span>{s.card1}</span></div>
              <div class="flex flex-1 flex-col gap-5 p-[22px]">
                <div class="uviz" aria-hidden="true">
                  <div class="mini mini-one">
                    <span class="mt"><i class="dw" style="width:30%"></i><i class="dw hot" style="width:70%;animation-delay:.25s"></i><i class="dw thin" style="width:85%;animation-delay:.5s"></i><i class="dw thin" style="width:60%;animation-delay:.65s"></i></span>
                    <span class="mp dw" style="animation-delay:.9s"><span class="mdot"></span></span>
                  </div>
                </div>
                <Cmd text={s.prompts.one} label={s.copyOne} copy={s.copy} wrap />
                <p class="m-0 text-base leading-relaxed text-body">{s.card1P}</p>
              </div>
            </article>
            <article class="win flex flex-col">
              <div class="winbar"><Icon name="LayoutGrid" size={16} class="text-hot" /><span>{s.card2}</span></div>
              <div class="flex flex-1 flex-col gap-5 p-[22px]">
                <div class="uviz" aria-hidden="true">
                  <div class="opts">
                    <div class="mini opt" style="animation-delay:0s"><b>A</b><span class="mt"><i style="width:40%"></i><i class="hot" style="width:75%"></i><i class="thin" style="width:80%"></i></span><span class="mp"></span></div>
                    <div class="mini opt" style="animation-delay:-6s;flex-direction:row-reverse"><b>B</b><span class="mt"><i style="width:40%"></i><i class="hot" style="width:75%"></i><i class="thin" style="width:80%"></i></span><span class="mp"><span class="mdot"></span></span></div>
                    <div class="mini opt" style="animation-delay:-4s;flex-direction:column"><b>C</b><span class="mt"><i class="hot" style="width:60%"></i><i class="thin" style="width:90%"></i></span><span class="mp" style="width:100%"></span></div>
                    <div class="mini opt" style="animation-delay:-2s"><b>D</b><span class="mp"></span><span class="mt"><i style="width:50%"></i><i class="hot" style="width:85%"></i><i class="thin" style="width:70%"></i></span></div>
                  </div>
                </div>
                <Cmd text={s.prompts.four} label={s.copyFour} copy={s.copy} wrap />
                <p class="m-0 text-base leading-relaxed text-body">{s.card2P}</p>
              </div>
            </article>
          </div>
          <div class="mt-5 flex flex-col gap-3 rounded-[18px] border-[1.5px] border-line bg-deep p-[18px]">
            <span class="eyebrow mb-0"><Icon name="WandSparkles" size={16} />{s.tipH}</span>
            <Cmd text={s.prompts.tip} label={s.copyTip} copy={s.copy} wrap />
            <span class="inline-flex items-center gap-2 text-sm text-muted"><Icon name="ShieldCheck" size={16} />{s.tipNote}</span>
          </div>
        </section>
      </div>

      <!-- Works with -->
      <section aria-labelledby="works" class="mqw relative overflow-hidden pt-3 pb-24">
        <h2 id="works" class="sr-only">{s.worksWith}</h2>
        <div class="mq">
          {
            agentLoop.map((g, i) => (
              <a class="agent" href={g.href} aria-hidden={i >= localAgents.length ? 'true' : undefined} tabindex={i >= localAgents.length ? -1 : undefined}>
                <span class="m" aria-hidden="true">
                  {g.logo ? <img src={g.logo} alt="" width="24" height="24" loading="lazy" decoding="async" /> : <Icon name="Puzzle" size={20} />}
                </span>
                <span class="font-semibold">{g.name}</span>
                <span class={`font-mono text-xs ${g.hot ? 'text-hot' : 'text-muted'}`}>{g.note}</span>
              </a>
            ))
          }
        </div>
      </section>

      <div class="relative mx-auto max-w-[1240px] px-6">
        <!-- Before / after -->
        <section aria-labelledby="ba" class="reveal flex flex-wrap items-center gap-10 pt-10 pb-24" id="ba-root" data-after="true">
          <div class="flex min-w-0 flex-[1_1_340px] flex-col gap-[18px]">
            <p class="eyebrow mb-0"><Icon name="Columns2" size={16} />{s.baEyebrow}</p>
            <h2 id="ba" class="m-0 text-[clamp(32px,4vw,52px)] leading-[1.05] font-semibold">{s.baH}</h2>
            <p class="m-0 text-lg leading-relaxed text-body">{s.baP}</p>
            <div class="flex flex-wrap gap-2.5">
              <button type="button" class="btn" data-ba="false" aria-pressed="false"><Icon name="EyeOff" />{s.without}</button>
              <button type="button" class="btn" data-ba="true" aria-pressed="true"><Icon name="Sparkles" />{s.with}</button>
            </div>
          </div>
          <div class="win min-w-0 flex-[1.4_1_520px]">
            <div class="winbar"><Icon name="FileText" size={16} class="text-hot" /><span>jano / README.md</span></div>
            <div class="flex min-h-[460px] flex-col gap-3.5 p-[22px]">
              <div class="ba-banner">
                <div>
                  <img src="/banners/jano/hero-dark.svg" data-banner="jano" alt={s.baAlt} width="1280" height="640" loading="lazy" decoding="async" class="block h-auto w-full rounded-xl border-[1.5px] border-line" />
                </div>
              </div>
              <div class="text-[30px] font-semibold">Jano</div>
              <div class="flex gap-2" aria-hidden="true"><span class="h-[22px] w-[90px] rounded bg-panel"></span><span class="h-[22px] w-[70px] rounded bg-panel"></span><span class="h-[22px] w-[80px] rounded bg-panel"></span></div>
              <span class="h-2 w-[94%] rounded bg-line" aria-hidden="true"></span>
              <span class="h-2 w-[88%] rounded bg-line" aria-hidden="true"></span>
              <span class="h-2 w-[60%] rounded bg-line" aria-hidden="true"></span>
              <span class="mt-2.5 h-4 w-[30%] rounded bg-bar" aria-hidden="true"></span>
              <span class="h-2 w-[90%] rounded bg-line" aria-hidden="true"></span>
              <span class="h-2 w-[74%] rounded bg-line" aria-hidden="true"></span>
            </div>
          </div>
        </section>

        <!-- Gallery -->
        <section id="gallery" class="reveal pt-10 pb-24">
          <div class="mb-7 flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class="eyebrow"><Icon name="Images" size={16} />{s.showroom}</p>
              <h2 class="m-0 text-[clamp(32px,4vw,52px)] font-semibold">{s.galleryH}</h2>
            </div>
            <p class="m-0 max-w-[40ch] text-lg text-body">{s.galleryP}</p>
          </div>
          <div class="grid grid-cols-[repeat(auto-fill,minmax(300px,1fr))] gap-4">
            {
              projects.map((p, i) =>
                i === 0 ? (
                  <button type="button" class="gcard gfeat col-span-full" data-open={i} aria-haspopup="dialog" aria-label={fill(s.openBanner, { name: p.name })}>
                    <span class="gimg"><img src={`/banners/${p.slug}/hero-dark.svg`} data-banner={p.slug} alt={fill(s.bannerAlt, { name: p.name, alt: p.alt })} width="1280" height="640" loading="lazy" decoding="async" /></span>
                    <span class="flex min-w-0 flex-col gap-3 pb-12">
                      <span class="inline-flex items-center gap-2 font-mono text-sm text-hot"><Icon name="Star" size={16} />{s.featured}</span>
                      <span class="text-2xl font-semibold">{p.name}</span>
                      <span class="text-[clamp(22px,2.4vw,30px)] leading-tight font-semibold">{p.tag}</span>
                      <span class="text-base leading-relaxed text-body">{p.alt}</span>
                    </span>
                    <span class="ex" aria-hidden="true"><Icon name="Plus" size={18} /></span>
                  </button>
                ) : (
                  <button type="button" class="gcard" data-open={i} aria-haspopup="dialog" aria-label={fill(s.openBanner, { name: p.name })}>
                    <span class="gimg"><img src={`/banners/${p.slug}/hero-dark.svg`} data-banner={p.slug} alt={fill(s.bannerAlt, { name: p.name, alt: p.alt })} width="1280" height="640" loading="lazy" decoding="async" /></span>
                    <span class="px-1.5 text-xl font-semibold">{p.name}</span>
                    <span class="px-1.5 pr-14 text-lg leading-snug text-body">{p.tag}</span>
                    <span class="ex" aria-hidden="true"><Icon name="Plus" size={18} /></span>
                  </button>
                ),
              )
            }
          </div>
        </section>

        <!-- Facts -->
        <section aria-label={s.factsLabel} class="reveal grid grid-cols-[repeat(auto-fit,minmax(240px,1fr))] gap-4 pt-10 pb-28">
          {
            s.facts.map((f) => (
              <div class="fact win p-6">
                <span class="fact-ic"><Icon name={f.icon} size={22} /></span>
                <p class="m-0 mt-4 mb-2.5 font-mono text-sm text-hot">{f.k}</p>
                <p class="m-0 text-xl leading-snug font-semibold">{f.v}</p>
              </div>
            ))
          }
        </section>

        <!-- Name -->
        <section id="name" aria-labelledby="why" class="reveal flex flex-wrap items-center gap-10 pt-10 pb-24">
          <div class="min-w-0 flex-[1_1_340px]">
            <p class="eyebrow"><Icon name="Landmark" size={16} />{s.nameEyebrow}</p>
            <h2 id="why" class="m-0 text-[clamp(32px,4vw,52px)] leading-[1.05] font-semibold">{s.nameH}</h2>
          </div>
          <div class="flex min-w-0 flex-[1.4_1_520px] flex-col gap-4 text-lg leading-relaxed text-body">
            {s.nameP.map((t) => <p class="m-0">{t}</p>)}
          </div>
        </section>

        <!-- FAQ -->
        <section id="faq" aria-labelledby="faq-title" class="reveal pt-10 pb-28">
          <p class="eyebrow"><Icon name="MessageCircleQuestion" size={16} />{s.faqEyebrow}</p>
          <h2 id="faq-title" class="m-0 mb-7 text-[clamp(32px,4vw,52px)] leading-[1.05] font-semibold">{s.faqH}</h2>
          <div class="grid grid-cols-[repeat(auto-fit,minmax(320px,1fr))] gap-4">
            {
              s.faqs.map((f) => (
                <div class="win p-6">
                  <h3 class="m-0 mb-2.5 text-xl leading-snug font-semibold">{f.q}</h3>
                  <p class="m-0 text-lg leading-relaxed text-body">{f.a}</p>
                </div>
              ))
            }
          </div>
        </section>

        <footer class="flex flex-wrap justify-between gap-3 border-t-[1.5px] border-line pt-7 pb-12 text-[15px] text-muted">
          <span class="inline-flex items-center gap-2"><Icon name="Scale" size={16} />{s.footer}</span>
          <a class="inline-flex items-center gap-2" href="https://github.com/ilien-dev/jano/releases"><Icon name="Tag" size={16} />{s.releases}</a>
        </footer>
      </div>
    </main>
  </div>

  <!-- Lightbox -->
  <dialog class="lb" id="lb" aria-labelledby="lb-title">
    <div class="win">
      <div class="winbar justify-between">
        <span class="flex items-center gap-2"><Icon name="Image" size={16} class="text-hot" /><span id="lb-file">anzu / hero-dark.svg</span></span>
        <button type="button" class="icon-btn" data-close aria-label={s.closePreview}><Icon name="X" size={20} /></button>
      </div>
      <div class="lb-body" id="lb-body">
        <img id="lb-img" src="/banners/anzu/hero-dark.svg" alt="" width="1280" height="640" decoding="async" class="block h-auto w-full" />
        <div class="flex flex-wrap items-start justify-between gap-4 p-[22px]">
          <div class="min-w-0 flex-[1_1_360px]">
            <h2 id="lb-title" class="m-0 mb-1.5 text-2xl font-semibold">Anzu</h2>
            <p id="lb-tag" class="m-0 text-lg text-body">{projects[0].tag}</p>
          </div>
          <div class="seg w-[240px]" id="lb-mode" data-tab="dark" role="group" aria-label={s.bannerTheme}>
            <span class="knob" aria-hidden="true"></span>
            <button type="button" data-mode="dark" aria-pressed="true"><Icon name="Moon" size={16} />{s.dark}</button>
            <button type="button" data-mode="light" aria-pressed="false"><Icon name="Sun" size={16} />{s.light}</button>
          </div>
        </div>
      </div>
      <div class="flex flex-wrap justify-between gap-3 border-t-[1.5px] border-line px-[22px] py-4">
        <div class="flex gap-2.5">
          <button type="button" class="btn btn-sq" data-step="-1" aria-label={s.prev}><Icon name="ChevronLeft" size={20} /></button>
          <button type="button" class="btn btn-sq" data-step="1" aria-label={s.next}><Icon name="ChevronRight" size={20} /></button>
        </div>
        <a class="btn btn-pri" id="lb-link" href="https://github.com/ilien-dev/anzu"><Icon name="github" />{s.openGh} <Icon name="ArrowUpRight" size={16} class="arr" /></a>
      </div>
    </div>
  </dialog>

  <script is:inline type="application/json" id="projects-data" set:html={JSON.stringify(projects)} />
</Layout>

<script>
  import '../scripts/main';
</script>
