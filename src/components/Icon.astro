---
// Build-time icons: Lucide (ISC) for UI, Simple Icons (CC0) for brand marks. No JS ships.
import * as lucide from 'lucide-static';
import { siGithub, siNpm } from 'simple-icons';

interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 18, class: cls = '' } = Astro.props;
const brands: Record<string, string> = { github: siGithub.path, npm: siNpm.path };

let svg: string;
if (brands[name]) {
  svg = `<svg class="icon ${cls}" width="${size}" height="${size}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="${brands[name]}"/></svg>`;
} else {
  const raw = (lucide as unknown as Record<string, string>)[name];
  if (!raw) throw new Error(`Unknown icon: ${name}`);
  svg = raw
    .replace(/class="[^"]*"/, `class="icon ${cls}" aria-hidden="true" focusable="false"`)
    .replace(/width="24"/, `width="${size}"`)
    .replace(/height="24"/, `height="${size}"`)
    .replace(/stroke-width="2"/, 'stroke-width="1.9"')
    .replace(/\n\s*/g, ' ');
}
---

<Fragment set:html={svg} />
