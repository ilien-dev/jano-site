---
import Icon from './Icon.astro';

interface Props {
  text: string;
  label: string;
  wrap?: boolean;
  prefix?: string;
  copy?: string;
  class?: string;
}

const { text, label, wrap = false, prefix, copy = 'Copy', class: cls = '' } = Astro.props;

// The parts that name the skill get the accent: /jano, /jano:jano, $jano, ilien-dev/jano, jano@jano.
// The command itself (/plugin, npx) gets a second, cooler accent and no underline.
const skill = /^(\/jano(?::jano)?|\$jano|ilien-dev\/jano|jano@jano)$/;
const verb = /^(\/plugin|npx)$/;
const parts = text
  .split(/(\/jano(?::jano)?|\$jano|ilien-dev\/jano|jano@jano|\/plugin|npx)/)
  .filter(Boolean)
  .map((t) => ({ t, cls: skill.test(t) ? 'sk' : verb.test(t) ? 'cv' : '' }));
---

<div class={`cmd ${wrap ? 'wrap' : ''} ${cls}`}>
  {prefix && <span class="cmd-pre" aria-hidden="true">{prefix}</span>}
  <code>{parts.map((p) => (p.cls ? <span class={p.cls}>{p.t}</span> : p.t))}</code>
  <button type="button" class="copy" data-copy={text} aria-label={label}>
    <Icon name="Copy" size={16} class="i-copy" />
    <Icon name="Check" size={16} class="i-done" />
    <span class="lbl">{copy}</span>
  </button>
</div>
