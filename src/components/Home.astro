---
// The home page, in the language the route passes. Every string lives in src/i18n.ts.
// Each section is a "console": a side column with the words and a main area where the
// README pictures Jano drew play, in the theme the visitor sees.
import Layout from '../layouts/Layout.astro';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import Cmd from './Cmd.astro';
import ThemeSwitch from './ThemeSwitch.astro';
import { agents } from '../data/projects';
import { strings, projectsFor, fill, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = strings[lang];
const projects = projectsFor(lang);
const site = 'https://jano.ilien.dev';
// A scene's dark file; main.ts swaps every [data-scene] to the visitor's theme.
const src = (file: string) => `/scenes/${file}-dark.svg`;
const jano = (name: string) => (lang === 'es' ? `es/jano-${name}` : `jano-${name}`);
const heroFile = (slug: string) => (slug === 'jano' ? jano('hero') : `${slug}-hero`);

// The version shown under /jano, read from the skill's plugin manifest at build time.
// If GitHub cannot be reached, the line leaves the number out instead of showing a stale one.
let version: string | null = null;
try {
  const res = await fetch('https://raw.githubusercontent.com/ilien-dev/jano/main/.claude-plugin/plugin.json');
  if (res.ok) version = (await res.json()).version ?? null;
} catch {}
const localAgents = agents.map((g) => (g.name === 'More agents' ? { ...g, name: s.moreAgents } : g));
const agentLoop = [...localAgents, ...localAgents, ...localAgents, ...localAgents];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: 'Jano',
      url: `${site}${s.path}`,
      inLanguage: lang,
      description: s.description,
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Windows, macOS, Linux',
      license: 'https://opensource.org/licenses/MIT',
      sameAs: 'https://github.com/ilien-dev/jano',
      keywords: s.keywords,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    },
    {
      '@type': 'FAQPage',
      inLanguage: lang,
      mainEntity: s.faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<Layout lang={lang} title={s.title} description={s.description} jsonLd={jsonLd} ogImageAlt={s.ogImageAlt} locale={s.locale}>
  <div class="relative overflow-hidden pb-10">
    <div class="dots" aria-hidden="true"></div>

    <header class="rise relative z-10 mx-auto flex max-w-[1240px] flex-wrap items-center justify-between gap-4 px-6 py-5">
      <a href="#top" aria-label={s.navHome} class="flex items-center gap-3 text-ink no-underline hover:text-ink">
        <Logo size={36} />
        <span class="text-[22px] font-semibold">Jano</span>
      </a>
      <nav aria-label={s.navMain} class="hidden gap-7 lg:flex">
        <a class="nav-a" href="#get">{s.nav.get}</a>
        <a class="nav-a" href="#who">{s.nav.who}</a>
        <a class="nav-a" href="#use">{s.nav.use}</a>
        <a class="nav-a" href="#faq">{s.nav.faq}</a>
      </nav>
      <div class="flex items-center gap-2.5">
        <a class="btn btn-sm btn-gh" href="https://github.com/ilien-dev/jano" aria-label="GitHub"><Icon name="github" /><span class="gh-t">GitHub</span> <Icon name="ArrowUpRight" size={16} class="arr" /></a>
        <a class="btn btn-sm" href={s.altHref} hreflang={s.altLang} lang={s.altLang} aria-label={s.altLabel}>{s.altShort}</a>
        <ThemeSwitch t={s.theme} />
      </div>
    </header>

    <main class="relative">
      <!-- First viewport: install beside the hero -->
      <section id="top" class="mx-auto max-w-[1240px] px-6 pt-8 pb-28">
        <div class="mb-9 flex flex-wrap items-end justify-between gap-x-10 gap-y-5">
          <h1 class="rise m-0 max-w-[16ch] text-[clamp(42px,5.4vw,76px)] leading-[0.96] font-semibold tracking-[-0.035em]" style="--d:.1s">
            {s.h1a} <span class="text-hot">{s.h1hot}</span> {s.h1b}
          </h1>
          <p class="rise m-0 max-w-[40ch] text-[19px] leading-relaxed text-body" style="--d:.25s">{s.lead}</p>
        </div>

        <div class="console pop" style="--d:.35s">
          <div id="install" class="c-side">
            <div>
              <div class="c-big"><span class="text-hot">/</span>jano<span class="blink"></span></div>
              <p class="m-0 mt-3 flex items-center gap-2 font-mono text-[13px] text-muted">
                <span class="live"></span>
                {version ? <a class="text-muted no-underline hover:text-ink" href={`https://github.com/ilien-dev/jano/releases/tag/v${version}`}>v{version}</a> : null}
                {version ? ' · ' : ''}{s.skillLine}
              </p>
            </div>
            <div class="c-rule"></div>
            <div class="seg" role="tablist" aria-label={s.installMethod} id="seg">
              <button type="button" role="tab" id="tab-plugin" aria-selected="true" aria-controls="panel-plugin" data-tab-btn="plugin">
                <img src="/logos/claude.svg" alt="" width="18" height="18" class="tab-logo" />{s.tabPlugin}
              </button>
              <button type="button" role="tab" id="tab-npx" aria-selected="false" aria-controls="panel-npx" data-tab-btn="npx" tabindex="-1">
                <Icon name="npm" size={18} class="tab-npm" />{s.tabNpx}
              </button>
            </div>
            <div class="panels">
              <div class="panel" role="tabpanel" id="panel-plugin" aria-labelledby="tab-plugin" data-active="true">
                <Cmd text="/plugin marketplace add ilien-dev/jano" label={s.copyMarket} copy={s.copy} prefix="1" />
                <Cmd text="/plugin install jano@jano" label={s.copyPlugin} copy={s.copy} prefix="2" />
              </div>
              <div class="panel" role="tabpanel" id="panel-npx" aria-labelledby="tab-npx" data-active="false" inert>
                <Cmd text="npx skills add ilien-dev/jano" label={s.copyNpx} copy={s.copy} prefix="$" />
              </div>
            </div>
            <p class="m-0 text-sm leading-normal text-muted">
              {s.py1} <a href="https://docs.astral.sh/uv/">uv</a> {s.py2} <code class="font-mono text-ink">pip install fonttools brotli</code> {s.py3}
            </p>
            <div class="c-rule"></div>
            <p class="m-0 font-mono text-xs text-muted">{s.runsIn}</p>
            <div class="flex flex-col gap-3 pb-2">
              {localAgents.map((g, i) => <span class="lit" style={`--ld:${i * 3.2}s`}><b></b>{g.name}<span class="note">{g.note}</span></span>)}
            </div>
          </div>
          <div class="c-main min-h-[440px] min-[901px]:items-start min-[901px]:pt-10">
            <div class="dots" aria-hidden="true"></div>
            <span class="zoom block w-full max-w-[860px]" style="box-shadow:var(--shadow)">
              <img class="scene" data-scene={jano('hero')} src={src(jano('hero'))} alt={s.heroAlt} width="1280" height="640" fetchpriority="high" decoding="async" />
            </span>
            <a class="c-go" href="#get" aria-label={s.seeMore}><Icon name="ArrowRight" size={26} /></a>
          </div>
        </div>
      </section>

      <!-- What you get -->
      <section id="get" class="mx-auto max-w-[1240px] px-6 pb-28">
        <div class="reveal mb-8 flex flex-wrap items-end justify-between gap-5">
          <div>
            <p class="eyebrow"><span class="live"></span>{s.getEyebrow}</p>
            <h2 class="h2 max-w-[16ch]">{s.getH}</h2>
          </div>
          <p class="m-0 max-w-[42ch] text-lg leading-relaxed text-body">{s.getP}</p>
        </div>
        <div class="console flip reveal">
          <div class="c-main">
            <div class="dots" aria-hidden="true"></div>
            <img class="scene" data-scene={jano('features')} src={src(jano('features'))} alt={s.getAlt} width="1280" height="448" loading="lazy" decoding="async" />
          </div>
          <ul class="c-side m-0 list-none justify-center gap-5">
            {s.getItems.map((t, i) => <li class="lit" style={`--ld:${i * 3.2}s`}><b></b>{t}</li>)}
          </ul>
        </div>
      </section>

      <!-- Who it is for: the front pages Jano made -->
      <section id="who" class="mx-auto max-w-[1240px] px-6 pb-28">
        <div class="reveal mb-8">
          <p class="eyebrow"><span class="live"></span>{s.whoEyebrow}</p>
          <h2 class="h2 max-w-[20ch]">{s.whoH}</h2>
        </div>
        <div class="console reveal">
          <div class="c-side gap-1.5 px-4 py-6" role="group" aria-label={s.whoEyebrow}>
            <p class="m-0 px-3.5 pb-2.5 font-mono text-xs text-muted">{fill(s.whoPick, { n: String(projects.length) })}</p>
            {
              projects.map((p, i) => (
                <button type="button" class="proj" data-proj={i} aria-pressed={i === 0 ? 'true' : 'false'} aria-controls={`readme-${p.slug}`}>
                  <span class="n">{String(i + 1).padStart(2, '0')}</span>
                  {p.name}
                  <span class="k">{p.full ? s.full : s.heroOnly}</span>
                </button>
              ))
            }
          </div>
          <div class="c-main flex-col items-stretch justify-start gap-4">
            {
              projects.map((p, i) => (
                <div class="readme" id={`readme-${p.slug}`} data-active={i === 0 ? 'true' : 'false'}>
                  <div class="flex flex-wrap items-center justify-between gap-3">
                    <div>
                      <h3 class="m-0 text-[26px] font-semibold">{p.name}</h3>
                      <p class="m-0 mt-1 text-body">{p.tag}</p>
                    </div>
                    <a class="btn btn-sm" href={p.url}><Icon name="github" />{s.openGh} <Icon name="ArrowUpRight" size={16} class="arr" /></a>
                  </div>
                  <span class="zoom block">
                    <img class="scene" data-scene={heroFile(p.slug)} src={src(heroFile(p.slug))} alt={fill(s.heroOf, { name: p.name, alt: p.alt })} width="1280" height="640" loading="lazy" decoding="async" />
                  </span>
                  {p.scenes.map((sc) => (
                    <span class="zoom block">
                      <img class="scene" data-scene={sc.file} src={src(sc.file)} alt={fill(s.sceneOf, { name: p.name, section: sc.alt })} width="1280" height="448" loading="lazy" decoding="async" />
                    </span>
                  ))}
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Use -->
      <section id="use" class="mx-auto max-w-[1240px] px-6 pb-28">
        <div class="reveal mb-8">
          <p class="eyebrow"><span class="live"></span>{s.useEyebrow}</p>
          <h2 class="h2 max-w-[18ch]">{s.useH}</h2>
        </div>
        <div class="console wide reveal">
          <div class="c-side">
            <p class="m-0 text-[17px] leading-relaxed text-body">{s.useP}</p>
            {
              s.prompts.map((p) => (
                <div class="flex flex-col gap-2">
                  <span class="font-mono text-xs text-muted">{p.caption}</span>
                  <Cmd text={p.text} label={p.label} copy={s.copy} />
                </div>
              ))
            }
            <p class="m-0 font-mono text-[13px] text-muted">{s.pluginNote}</p>
          </div>
          <div class="c-main">
            <div class="dots" aria-hidden="true"></div>
            <img class="scene" data-scene={jano('use')} src={src(jano('use'))} alt={s.useAlt} width="1280" height="448" loading="lazy" decoding="async" />
          </div>
        </div>
      </section>

      <!-- Before / after -->
      <section aria-labelledby="ba-h" class="mx-auto max-w-[1240px] px-6 pb-28">
        <div class="console wide reveal" id="ba-root" data-after="true">
          <div class="c-side justify-center">
            <p class="eyebrow"><span class="live"></span>{s.baEyebrow}</p>
            <h2 id="ba-h" class="m-0 text-[38px] leading-[1.05] font-semibold tracking-[-0.02em]">{s.baH}</h2>
            <div class="seg self-start" role="group" aria-label={s.baGroup}>
              <button type="button" data-ba="false" aria-pressed="false">{s.without}</button>
              <button type="button" data-ba="true" aria-pressed="true">{s.with}</button>
            </div>
          </div>
          <div class="c-main items-stretch">
            <div class="dots" aria-hidden="true"></div>
            <div class="flex w-full flex-col gap-3.5 rounded-[22px] border-[1.5px] border-line bg-deep p-6">
              <p class="m-0 font-mono text-[13px] text-muted">jano / README.md</p>
              <div data-ba-view="after">
                <img class="scene" data-scene={jano('hero')} src={src(jano('hero'))} alt="" width="1280" height="640" loading="lazy" decoding="async" />
                <p class="m-0 text-[28px] leading-tight font-semibold">{s.baTitle}</p>
                <img class="scene" data-scene={jano('features')} src={src(jano('features'))} alt="" width="1280" height="448" loading="lazy" decoding="async" />
              </div>
              <div data-ba-view="before" aria-hidden="true">
                <p class="m-0 text-[28px] font-semibold">jano</p>
                <div class="bars"><span class="bar w-[92%]"></span><span class="bar w-[84%]"></span><span class="bar w-[56%]"></span></div>
                <p class="m-0 mt-2.5 font-mono text-sm text-muted">## Install</p>
                <div class="bars"><span class="bar w-[78%]"></span><span class="bar w-[66%]"></span></div>
                <p class="m-0 mt-2.5 font-mono text-sm text-muted">## Usage</p>
                <div class="bars"><span class="bar w-[88%]"></span><span class="bar w-[40%]"></span></div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Works with -->
      <section aria-labelledby="works" class="reveal relative pb-28">
        <h2 id="works" class="sr-only">{s.worksWith}</h2>
        <div class="mqw">
          <div class="mq">
            {
              agentLoop.map((g, i) => (
                <a class="agent" href={g.href} aria-hidden={i >= localAgents.length ? 'true' : undefined} tabindex={i >= localAgents.length ? -1 : undefined}>
                  <span class="m" aria-hidden="true">
                    {g.logo ? <img src={g.logo} alt="" width="24" height="24" loading="lazy" decoding="async" /> : <Icon name="Puzzle" size={20} />}
                  </span>
                  <span class="font-semibold">{g.name}</span>
                  <span class="font-mono text-xs text-muted">{g.note}</span>
                </a>
              ))
            }
          </div>
        </div>
      </section>

      <!-- The name -->
      <section id="name" aria-labelledby="name-h" class="mx-auto max-w-[1240px] px-6 pb-28">
        <div class="console half reveal">
          <div class="c-side min-h-[320px] items-center justify-center">
            <div class="flex gap-[18px]" aria-hidden="true">
              <span class="face bob border-[1.5px] border-[#34446A] bg-[#0E1526] text-[#EEF2F7]">{s.dark}</span>
              <span class="face bob border-[1.5px] border-[#C9D3E3] bg-[#F5F7FB] text-[#1B2A4A]" style="animation-delay:-2.5s">{s.light}</span>
            </div>
          </div>
          <div class="c-main flex-col items-start gap-4 p-11">
            <div class="dots" aria-hidden="true"></div>
            <p class="eyebrow">{s.nameEyebrow}</p>
            <h2 id="name-h" class="m-0 text-[40px] font-semibold tracking-[-0.02em]">{s.nameH}</h2>
            <p class="m-0 text-[19px] leading-relaxed text-body">{s.nameP}</p>
          </div>
        </div>
      </section>

      <!-- Questions -->
      <section id="faq" aria-labelledby="faq-h" class="mx-auto max-w-[1240px] px-6 pb-24">
        <div class="reveal mb-4">
          <p class="eyebrow"><span class="live"></span>{s.faqEyebrow}</p>
          <h2 id="faq-h" class="h2">{s.faqH}</h2>
        </div>
        <div class="reveal border-t-[1.5px] border-line">
          {
            s.faqs.map((f) => (
              <details class="faq">
                <summary>
                  {f.q}
                  <span class="pl" aria-hidden="true"><Icon name="Plus" size={18} /></span>
                </summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>
      </section>

      <footer class="reveal mx-auto flex max-w-[1240px] flex-wrap justify-between gap-3 border-t-[1.5px] border-line px-6 pt-7 text-[15px] text-muted">
        <span class="inline-flex items-center gap-2"><Icon name="Scale" size={16} />{s.footer}</span>
        <a class="nav-a inline-flex items-center gap-2" href="https://github.com/ilien-dev/jano/releases"><Icon name="Tag" size={16} />{s.releases}</a>
      </footer>
    </main>
  </div>
</Layout>

<script>
  import '../scripts/main';
</script>
