---
import Layout from '../../layouts/Layout.astro';
import Logo from '../../components/Logo.astro';
---

<Layout standalone lang="es" locale="es_ES" ogImageAlt="Jano: banners animados para el README de GitHub, en modo oscuro y claro." title="Página no encontrada · Jano" description="Esta página no existe. Vuelve a Jano, el banner animado para el README de GitHub.">
  <main class="relative flex min-h-dvh items-center justify-center overflow-hidden px-6">
    <div class="dots" aria-hidden="true"></div>
    <div class="rise relative flex flex-col items-center gap-6 text-center">
      <Logo size={72} />
      <h1 class="m-0 text-[clamp(40px,6vw,72px)] leading-none font-semibold">A este bucle <span class="text-hot">le falta un trozo.</span></h1>
      <p class="m-0 text-lg text-body">La página que buscas no está aquí.</p>
      <a class="btn btn-pri" href="/es/">Volver a Jano <span class="arr" aria-hidden="true">→</span></a>
    </div>
  </main>
</Layout>
